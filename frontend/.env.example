# LUMA frontend environment example. Only VITE_* variables are exposed to browser code.

# Required. This must be the backend API URL, not the frontend domain.
VITE_API_BASE_URL=your_existing_backend_production_url_here/api
VITE_API_URL=your_existing_backend_production_url_here/api

# Public site URL
VITE_SITE_URL=https://shopwithluma.com

# Optional Google sign-in. Leave blank to show a clean disabled Google state.
VITE_GOOGLE_CLIENT_ID=

# Optional Google Maps/Places autocomplete. Leave blank to use manual address entry.
VITE_GOOGLE_MAPS_API_KEY=

# Optional manual WhatsApp link number.
VITE_WHATSAPP_NUMBER=

# Optional browser-only pixels. Internal automation must not depend on these.
VITE_GA_MEASUREMENT_ID=

# Optional future guard. Keep false unless a verified multi-currency flow exists.
VITE_ENABLE_MULTI_CURRENCY=false
