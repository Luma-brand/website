# LUMA backend environment example. Never commit real secrets here.

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend/backend URLs
# Local development: FRONTEND_URL=http://localhost:5173 and BACKEND_URL=http://localhost:5000
# Production: FRONTEND_URL=https://shopwithluma.com and BACKEND_URL=https://website-ikv5.onrender.com
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_2=https://website-umber-xi-40.vercel.app
BACKEND_URL=http://localhost:5000

# CORS/API/payment
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
RESEND_API_KEY=your_resend_api_key_here

# Resend email. RESEND_API_KEY must stay backend-only.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=LUMA <hello@shopwithluma.com>
RESEND_FROM_EMAIL=LUMA <hello@shopwithluma.com>
EMAIL_REPLY_TO=support@shopwithluma.com
SUPPORT_EMAIL=support@shopwithluma.com
SUPPORT_FROM=LUMA Support <support@shopwithluma.com>
HELLO_EMAIL=hello@shopwithluma.com
HELLO_FROM=LUMA <hello@shopwithluma.com>
MAIL_INBOXES=support@shopwithluma.com,hello@shopwithluma.com
DEFAULT_MAIL_INBOX=support@shopwithluma.com
ADMIN_EMAIL=admin@example.com
ADMIN_TEST_EMAIL=admin@example.com

# Abandoned cart automation
ABANDONED_CART_EMAIL_ENABLED=true
ABANDONED_CART_DELAY_MINUTES=2
ABANDONED_CART_MAX_EMAILS=3
CRON_SECRET=replace_with_long_random_cron_secret
RESEND_WEBHOOK_SECRET=

# Optional Google sign-in. GOOGLE_CLIENT_SECRET is only needed if OAuth code flow is added.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=

# Optional Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_FOLDER=luma/products

# Optional manual WhatsApp follow-up links. No automatic WhatsApp sending is used.
WHATSAPP_NUMBER=

# Optional future payment provider placeholders. Do not enable until fully implemented.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Optional backend-side integration status only. Browser tracking IDs belong in frontend VITE_* vars.
GA_MEASUREMENT_ID=


