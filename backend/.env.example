# LUMA backend environment example. Never commit real secrets here.

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend/backend URLs
# Production: FRONTEND_URL=https://shopwithluma.com
# Production backend currently: https://website-ikv5.onrender.com
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_2=https://website-umber-xi-40.vercel.app
BACKEND_URL=http://localhost:5000

# Paystack checkout. Secret key must remain backend-only.
# The current integration uses Paystack-hosted checkout, so a public key is not required in the browser.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/paystack/callback
# Configure this webhook in Paystack Dashboard:
# https://website-ikv5.onrender.com/api/webhooks/paystack

# Resend transactional / broadcast email. API key must remain backend-only.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=LUMA <hello@shopwithluma.com>
RESEND_FROM_EMAIL=LUMA <hello@shopwithluma.com>
EMAIL_REPLY_TO=support@shopwithluma.com
SUPPORT_EMAIL=support@shopwithluma.com
SUPPORT_FROM=LUMA Support <support@shopwithluma.com>
HELLO_EMAIL=hello@shopwithluma.com
HELLO_FROM=LUMA <hello@shopwithluma.com>
ADMIN_EMAIL=admin@example.com
ADMIN_TEST_EMAIL=admin@example.com

# Abandoned cart / automation
ABANDONED_CART_EMAIL_ENABLED=true
ABANDONED_CART_DELAY_MINUTES=60
ABANDONED_CART_MAX_EMAILS=3
CRON_SECRET=replace_with_long_random_cron_secret
RESEND_WEBHOOK_SECRET=

# Optional Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_FOLDER=luma/products

# Optional WhatsApp follow-up links. Full automatic WhatsApp delivery requires an approved provider/API.
WHATSAPP_NUMBER=

# Optional analytics / integrations. Browser tracking IDs belong in frontend VITE_* vars where applicable.
GA_MEASUREMENT_ID=
# Automated FX display-rate sync (NGN remains Paystack settlement currency)
FX_API_URL=https://open.er-api.com/v6/latest/NGN
FX_API_TIMEOUT_MS=10000
FX_MAX_MOVEMENT_PERCENT=20
# Set true only when an external cron owns every background job.
DISABLE_INTERNAL_WORKERS=false
